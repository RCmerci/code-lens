(require 'ert)
(unless (ert-test-boundp 'lens-isolated-runtime)
  (load (expand-file-name "tests/review-test.el" lens-root) nil t))

(ert-deftest lens-codex-loaded-readonly-and-key-scope ()
  (should (featurep 'codex-ide))
  (should-not (featurep 'codex))
  (should (package-installed-p 'codex-ide '(0 3 2)))
  (should (equal codex-ide-sandbox-mode "read-only"))
  (should (equal codex-ide-approval-policy "on-request"))
  (should-not codex-ide-emacs-context-policy)
  (should-not codex-ide-want-mcp-bridge)
  (lens-test-project
   (should (equal (alist-get 'cwd (codex-ide--thread-start-params)) directory))
   (should (equal (alist-get 'sandbox (codex-ide--thread-start-params)) "read-only"))
   (should (equal (alist-get 'approvalPolicy (codex-ide--thread-start-params)) "on-request")))
  (dolist (mode '(clojure-mode tuareg-mode))
    (with-temp-buffer
      (funcall mode)
      (should (eq (key-binding "c") 'lens-codex-question))
      (should (eq (key-binding "f") 'project-find-file))
      (read-only-mode -1)
      (should (eq (key-binding "c") 'self-insert-command))
      (should (eq (key-binding "f") 'self-insert-command))
      (read-only-mode 1)
      (lens-reading-mode -1)
      (should (eq (key-binding "c") 'self-insert-command))
      (should (eq (key-binding "f") 'self-insert-command))))
  (with-temp-buffer
    (emacs-lisp-mode)
    (should (eq (key-binding "c") 'self-insert-command))))

(ert-deftest lens-codex-presets-capture-source-before-selection ()
  (lens-test-project
   (dolist (relative '("src/空间 文件.mli" "test/空间 文件.mli"))
     (let ((file (expand-file-name relative directory)) captured)
       (make-directory (file-name-directory file) t)
       (with-temp-file file (insert "val unique_saved_answer : int -> int\n"))
       (switch-to-buffer (find-file-noselect file))
       (let ((inhibit-read-only t)) (goto-char (point-max)) (insert "UNSAVED_PRIVATE_SELECTION"))
       (goto-char 5)
       (push-mark (point-max) t t)
       (let ((source (current-buffer)) (origin (point)) (text (buffer-string)))
         (cl-letf (((symbol-function 'completing-read)
                    (lambda (miniprompt candidates &rest _)
                      (should (string-match-p "未保存修改" miniprompt))
                      (should (equal candidates (mapcar (lambda (template) (format template relative)) lens-codex-prompt-templates)))
                      (switch-to-buffer (get-buffer-create " *fake codex target*"))
                      (car (last candidates))))
                   ((symbol-function 'lens-codex-dispatch)
                    (lambda (context prompt) (setq captured (list context prompt)))))
           (lens-codex-question))
         (should (eq (plist-get (car captured) :buffer) source))
         (should (plist-get (car captured) :project))
         (should (equal (plist-get (car captured) :relative-file) relative))
         (should (equal (plist-get (car captured) :file) file))
         (should (equal (plist-get (car captured) :root) (file-name-as-directory directory)))
         (should (string-match-p (regexp-quote (format "给我解释当前文件<%s>中最重要的几个类型和函数" relative)) (cadr captured)))
         (should-not (plist-member (car captured) :text))
         (should-not (plist-member (car captured) :region))
         (should-not (string-match-p (regexp-quote directory) (cadr captured)))
         (dolist (token '("unique_saved_answer" "UNSAVED_PRIVATE_SELECTION"))
           (should-not (string-match-p (regexp-quote token) (cadr captured))))
         (should (equal (with-temp-buffer (insert-file-contents file) (buffer-string)) "val unique_saved_answer : int -> int\n"))
         (with-current-buffer source
           (should (= origin (point)))
           (should (equal text (buffer-string)))
           (should (buffer-modified-p))
           (should buffer-read-only)))))))

(ert-deftest lens-codex-cancel-and-fileless-do-not-dispatch ()
  (lens-test-project
   (with-current-buffer (find-file-noselect clj)
     (let ((calls 0))
       (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil)))
                 ((symbol-function 'lens-codex-dispatch) (lambda (&rest _) (cl-incf calls))))
         (condition-case nil (lens-codex-question) (quit nil)))
       (should (= calls 0))))
   (with-temp-buffer
     (clojure-mode)
     (should-error (lens-codex-question) :type 'user-error))))

