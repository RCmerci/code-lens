(ert-deftest lens-codex-interactive-free-question-and-empty-input ()
  :tags '(interactive)
  (skip-unless (not noninteractive))
  (should vertico-mode)
  (should (memq 'orderless completion-styles))
  (lens-test-project
   (dolist (file (list clj ml))
     (switch-to-buffer (find-file-noselect file))
     (let ((source (current-buffer)) (text (buffer-string)) sent
           (question "WHY_UNMATCHED_100%_QUESTION")
           (outside-map vertico-map))
       (cl-letf (((symbol-function 'lens-codex-dispatch)
                  (lambda (context prompt) (setq sent (list context prompt)))))
         ;; Real c -> Vertico/Orderless -> unmatched input -> RET -> dispatcher.
         (execute-kbd-macro (vconcat "c" question (kbd "RET")))
         (should (eq (plist-get (car sent) :buffer) source))
         (should (string-match-p (regexp-quote question) (cadr sent)))
         (should (string-match-p (regexp-quote (concat "当前文件<" (file-relative-name file directory) ">")) (cadr sent)))
         (should (eq outside-map vertico-map))
         ;; A literal input that partially matches a preset remains available via M-RET.
         (setq sent nil)
         (execute-kbd-macro (vconcat "c" "glossary" (kbd "M-RET")))
         (should (string-suffix-p "\nglossary" (cadr sent)))
         ;; Explicit candidate selection with no typed text still works.
         (setq sent nil)
         (execute-kbd-macro (vconcat "c" (kbd "C-n RET")))
         (should sent)
         (should (cl-some (lambda (template)
                            (string-suffix-p (format template (file-relative-name file directory)) (cadr sent)))
                          lens-codex-prompt-templates))
         (dolist (blank '("" "   "))
           (setq sent nil)
           (should-error (execute-kbd-macro (vconcat "c" blank (kbd "RET"))) :type 'user-error)
           (should-not sent))
         (setq sent nil)
         (execute-kbd-macro (vconcat "c" question (kbd "C-g")))
         (setq quit-flag nil)
         (should-not sent))
       (should (eq source (current-buffer)))
       (should (equal text (buffer-string)))
       (should buffer-read-only)))
   (message "REAL free-question Emacs=%s: unmatched RET, literal M-RET, explicit preset; empty/whitespace/cancel no dispatch"
            emacs-version)))
